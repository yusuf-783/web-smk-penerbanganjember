---
interface Props {
  schoolName?: string;
  vision?: string;
}

const { 
  schoolName = 'SMK Penerbangan Jember', 
  vision = 'Mewujudkan lulusan yang beriman, bertaqwa, kompeten, berkarakter, dan berdaya saing global di bidang kedirgantaraan.' 
} = Astro.props;
---

<section class="relative bg-gradient-to-br from-blue-800 via-blue-900 to-indigo-950 text-white py-16 sm:py-20 lg:py-24 overflow-hidden">
  <!-- Subtle Background Grid/Pattern -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff_1.5px,transparent_1.5px)] [background-size:24px_24px]"></div>
  <div class="absolute -right-20 -top-20 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Content -->
      <div class="lg:col-span-7 text-left space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-yellow-300 text-xs font-semibold uppercase tracking-wider">
          <span>✈️</span>
          <span>Penerimaan Taruna Baru (PPDB) Telah Dibuka</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]">
          Pintu Gerbang Menuju Karir <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-yellow-200 to-amber-400">
            Dunia Penerbangan
          </span>
        </h1>
        
        <p class="text-base sm:text-lg text-blue-100/90 leading-relaxed max-w-2xl font-light">
          {vision}
        </p>

        <div class="pt-2 flex flex-wrap gap-4 items-center">
          <a 
            href="/majors" 
            class="bg-yellow-400 text-blue-950 px-6 sm:px-8 py-3.5 rounded-xl font-extrabold text-sm sm:text-base hover:bg-yellow-300 transition shadow-lg hover:shadow-yellow-400/30 hover:-translate-y-0.5 active:translate-y-0 duration-150 inline-flex items-center gap-2"
          >
            <span>Jelajahi Jurusan</span>
            <span>✈️</span>
          </a>
          <a 
            href="/about" 
            class="border-2 border-white/40 text-white px-6 sm:px-8 py-3.5 rounded-xl font-bold text-sm sm:text-base hover:bg-white hover:text-blue-950 transition backdrop-blur-sm hover:-translate-y-0.5 active:translate-y-0 duration-150"
          >
            Profil Sekolah
          </a>
        </div>
      </div>

      <!-- Right Column: Visual Highlight Card -->
      <div class="lg:col-span-5">
        <div class="bg-white/10 backdrop-blur-md rounded-3xl p-6 sm:p-8 border border-white/20 shadow-2xl space-y-6">
          <div class="flex items-center justify-between border-b border-white/15 pb-4">
            <div>
              <span class="text-xs uppercase tracking-wider text-blue-200 font-semibold block">SMK Penerbangan</span>
              <h3 class="text-lg font-bold text-white">Akreditasi "A" Unggul</h3>
            </div>
            <span class="text-3xl">🏅</span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-blue-950/40 rounded-2xl p-4 border border-white/10 text-center">
              <div class="text-2xl sm:text-3xl font-black text-yellow-300 mb-1">4</div>
              <div class="text-xs text-blue-200 font-medium">Program Keahlian</div>
            </div>
            <div class="bg-blue-950/40 rounded-2xl p-4 border border-white/10 text-center">
              <div class="text-2xl sm:text-3xl font-black text-yellow-300 mb-1">100%</div>
              <div class="text-xs text-blue-200 font-medium">Fasilitas Praktik</div>
            </div>
          </div>

          <div class="bg-gradient-to-r from-blue-600/60 to-indigo-600/60 rounded-2xl p-4 border border-white/15 text-xs text-blue-100 flex items-center gap-3">
            <span class="text-2xl">👨‍✈️</span>
            <div>
              <p class="font-bold text-white">Disiplin Semi Militer & Karakter Unggul</p>
              <p class="text-blue-200 mt-0.5">Membentuk mental tangguh, disiplin, dan etika kerja standar kedirgantaraan.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
