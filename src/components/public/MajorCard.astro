---
interface Props {
  major: {
    code?: string;
    name: string;
    description?: string;
    icon?: string;
    career?: string;
  };
  compact?: boolean;
}

const { major, compact = false } = Astro.props;
---

<div class={`bg-white rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col group ${compact ? 'h-full' : ''}`}>
  <div class="bg-gradient-to-r from-blue-800 to-blue-600 p-6 text-white flex items-center justify-between">
    <div class="flex items-center gap-3.5">
      <div class="w-13 h-13 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center text-3xl group-hover:scale-110 transition duration-300 shadow-inner">
        {major.icon || '✈️'}
      </div>
      <div>
        {major.code && (
          <span class="text-xs font-bold uppercase tracking-wider bg-yellow-400 text-blue-950 px-2.5 py-0.5 rounded-md">
            {major.code}
          </span>
        )}
        <h3 class="text-lg sm:text-xl font-bold mt-1.5 leading-snug line-clamp-1">{major.name}</h3>
      </div>
    </div>
  </div>
  
  <div class="p-6 flex-1 flex flex-col justify-between space-y-5">
    <div>
      <p class="text-gray-600 text-sm leading-relaxed line-clamp-3">
        {major.description}
      </p>
    </div>

    {!compact && major.career && (
      <div class="bg-blue-50/80 p-4 rounded-2xl border border-blue-100">
        <span class="text-xs font-bold text-blue-900 uppercase tracking-wider block mb-1">💼 Prospek Karir & Profesi:</span>
        <p class="text-xs sm:text-sm text-blue-950 font-medium leading-relaxed">{major.career}</p>
      </div>
    )}

    <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
      <span class="text-xs text-gray-500 font-semibold">Akreditasi A</span>
      <a href="/majors" class="text-xs sm:text-sm font-bold text-blue-700 hover:text-blue-900 transition flex items-center gap-1 group-hover:translate-x-1">
        Detail Jurusan →
      </a>
    </div>
  </div>
</div>
