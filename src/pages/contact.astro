---
export const prerender = false;

import PublicLayout from '../layouts/PublicLayout.astro';
import { supabase } from '../lib/supabase';

const { data: school } = await supabase.from('school_info').select('*').single();
---

<PublicLayout title="Hubungi Kami" description="Layanan informasi, kontak resmi, dan konsultasi pendaftaran PPDB SMK Penerbangan Jember.">
  <!-- Page Header Banner -->
  <section class="bg-gradient-to-r from-blue-900 via-indigo-950 to-slate-950 text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-yellow-300 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span>✉️</span>
        <span>Layanan Informasi & Konsultasi</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">Hubungi Kami</h1>
      <p class="text-base sm:text-lg max-w-2xl mx-auto text-blue-100/90 leading-relaxed font-light">
        Kami siap melayani pertanyaan seputar pendaftaran taruna baru (PPDB), kerja sama industri kedirgantaraan, dan informasi akademik sekolah.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Section -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Contact Details Left Column -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-sm border border-gray-100 space-y-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-3 py-1 rounded-full">Sekretariat</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-2.5">Informasi Kontak</h2>
              <p class="text-gray-600 text-sm mt-1">Silakan kunjungi kampus kami atau hubungi nomor layanan berikut.</p>
            </div>

            <div class="space-y-6 text-sm sm:text-base">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-700 rounded-2xl flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 shadow-sm">
                  📍
                </div>
                <div>
                  <h3 class="font-bold text-gray-900">Alamat Kampus</h3>
                  <p class="text-gray-600 mt-0.5 leading-relaxed">{school?.address || 'Jl. Penerbangan No. 1, Jember, Jawa Timur'}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-700 rounded-2xl flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 shadow-sm">
                  📞
                </div>
                <div>
                  <h3 class="font-bold text-gray-900">Telepon & WhatsApp PPDB</h3>
                  <p class="text-gray-600 mt-0.5">{school?.phone || '(0331) 123456'}</p>
                  <p class="text-xs text-gray-500 mt-0.5">Senin - Sabtu: 07.30 - 15.00 WIB</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-700 rounded-2xl flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 shadow-sm">
                  ✉️
                </div>
                <div>
                  <h3 class="font-bold text-gray-900">Email Resmi</h3>
                  <p class="text-gray-600 mt-0.5">{school?.email || 'info@smkpenerbangan.sch.id'}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form Right Column -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-3xl shadow-sm border border-gray-100 space-y-6">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-100 px-3 py-1 rounded-full">Formulir Pesan</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-2.5">Kirim Pesan Langsung</h2>
              <p class="text-gray-600 text-sm mt-1">Sampaikan pesan, masukan, atau pertanyaan Anda langsung kepada staf kami.</p>
            </div>

            <form id="contactForm" class="space-y-4">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="name">
                    Nama Lengkap <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    required 
                    placeholder="Contoh: Budi Santoso" 
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition" 
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="email">
                    Alamat Email <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    required 
                    placeholder="email@domain.com" 
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition" 
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="subject">
                  Subjek / Perihal <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="subject" 
                  required 
                  placeholder="Contoh: Pertanyaan Syarat Pendaftaran PPDB" 
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition" 
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="message">
                  Pesan Anda <span class="text-red-500">*</span>
                </label>
                <textarea 
                  id="message" 
                  required 
                  rows="4" 
                  placeholder="Tuliskan pertanyaan atau pesan lengkap Anda di sini..." 
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition leading-relaxed"
                ></textarea>
              </div>

              <!-- KEAMANAN VERIFIKASI CAPTCHA -->
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
                <div class="flex items-center justify-between">
                  <label class="flex items-center gap-1.5 text-xs font-bold text-gray-700 uppercase tracking-wider" for="captchaInput">
                    <span>🛡️</span>
                    <span>Verifikasi Keamanan (Captcha):</span>
                    <span class="text-red-500">*</span>
                  </label>
                  <button 
                    type="button" 
                    id="refreshCaptchaBtn" 
                    class="text-xs font-bold text-blue-700 hover:text-blue-900 flex items-center gap-1 cursor-pointer bg-blue-50 px-2.5 py-1 rounded-lg hover:bg-blue-100 transition"
                    title="Ganti Soal Captcha"
                  >
                    <span>🔄</span>
                    <span>Acak Soal</span>
                  </button>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-3">
                  <!-- Captcha Challenge Badge Box -->
                  <div class="w-full sm:w-48 bg-gradient-to-r from-blue-900 to-indigo-950 text-white font-mono text-lg font-black tracking-widest px-4 py-3 rounded-xl shadow-inner text-center select-none border border-blue-800">
                    <span id="captchaQuestion">Menghitung...</span>
                  </div>

                  <div class="w-full flex-1">
                    <input 
                      type="number" 
                      id="captchaInput" 
                      required 
                      placeholder="Masukkan hasil angka di sini..." 
                      class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition font-semibold"
                    />
                  </div>
                </div>
                <p class="text-[11px] text-gray-400">
                  Hitung penjumlahan / pengurangan di atas untuk membuktikan bahwa Anda bukan robot sebelum mengirim pesan.
                </p>
              </div>

              <div id="msg" class="hidden p-4 rounded-xl text-xs sm:text-sm font-semibold"></div>

              <button 
                type="submit" 
                id="submitContactBtn"
                class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3.5 px-6 rounded-xl transition shadow-md hover:shadow-lg text-sm sm:text-base cursor-pointer flex items-center justify-center gap-2"
              >
                <span>Kirim Pesan Sekarang 🚀</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<script>
  let captchaAnswer = 0;

  function generateCaptcha() {
    const operations = ['+', '-', '+'];
    const op = operations[Math.floor(Math.random() * operations.length)];
    let n1 = Math.floor(Math.random() * 15) + 5; // 5 - 19
    let n2 = Math.floor(Math.random() * 9) + 1;  // 1 - 9

    if (op === '-' && n1 < n2) {
      const temp = n1;
      n1 = n2;
      n2 = temp;
    }

    if (op === '+') {
      captchaAnswer = n1 + n2;
    } else {
      captchaAnswer = n1 - n2;
    }

    const questionEl = document.getElementById('captchaQuestion');
    if (questionEl) {
      questionEl.textContent = `${n1} ${op} ${n2} = ?`;
    }

    const input = document.getElementById('captchaInput') as HTMLInputElement;
    if (input) {
      input.value = '';
    }
  }

  // Tombol Refresh Captcha
  document.getElementById('refreshCaptchaBtn')?.addEventListener('click', generateCaptcha);

  // Inisialisasi Captcha saat halaman termuat
  generateCaptcha();

  // Form Submit Handler
  document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msgDiv = document.getElementById('msg')!;
    const captchaInput = document.getElementById('captchaInput') as HTMLInputElement;
    const userAnswer = parseInt(captchaInput.value.trim(), 10);

    // 1. Validasi CAPTCHA terlebih dahulu
    if (isNaN(userAnswer) || userAnswer !== captchaAnswer) {
      msgDiv.className = 'p-4 rounded-xl text-xs sm:text-sm bg-red-50 text-red-700 border border-red-200 block';
      msgDiv.textContent = '❌ Jawaban Captcha salah! Silakan hitung ulang soal verifikasi keamanan di atas.';
      captchaInput.classList.add('border-red-500', 'bg-red-50');
      generateCaptcha();
      return;
    }

    captchaInput.classList.remove('border-red-500', 'bg-red-50');
    msgDiv.className = 'p-4 rounded-xl text-xs sm:text-sm bg-blue-50 text-blue-700 border border-blue-200 block';
    msgDiv.textContent = '⏳ Sedang mengirimkan pesan Anda...';

    const submitBtn = document.getElementById('submitContactBtn') as HTMLButtonElement;
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (document.getElementById('name') as HTMLInputElement).value,
          email: (document.getElementById('email') as HTMLInputElement).value,
          subject: (document.getElementById('subject') as HTMLInputElement).value,
          message: (document.getElementById('message') as HTMLTextAreaElement).value
        })
      });

      const data = await res.json();
      
      if (res.ok && data.success) {
        msgDiv.className = 'p-4 rounded-xl text-xs sm:text-sm bg-emerald-50 text-emerald-800 border border-emerald-300 block';
        msgDiv.textContent = '✅ Pesan berhasil dikirim! Tim SMK Penerbangan Jember akan segera menghubungi Anda.';
        (e.target as HTMLFormElement).reset();
        generateCaptcha();
      } else {
        msgDiv.className = 'p-4 rounded-xl text-xs sm:text-sm bg-red-50 text-red-700 border border-red-200 block';
        msgDiv.textContent = '❌ Gagal: ' + (data.error || 'Terjadi kesalahan saat mengirim pesan.');
        generateCaptcha();
      }
    } catch (err) {
      msgDiv.className = 'p-4 rounded-xl text-xs sm:text-sm bg-red-50 text-red-700 border border-red-200 block';
      msgDiv.textContent = '❌ Terjadi gangguan koneksi internet.';
      generateCaptcha();
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>