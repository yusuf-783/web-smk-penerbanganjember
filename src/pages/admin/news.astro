---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { formatGoogleDriveImageUrl } from '../../lib/gdrive';

// Ambil semua data berita dari Supabase
const { data: newsList, error } = await supabaseAdmin
  .from('news')
  .select('*')
  .order('published_at', { ascending: false });

const categories = ['Kegiatan', 'Prestasi', 'PPDB', 'Akademik', 'Pengumuman', 'Fasilitas'];
---

<AdminLayout title="Manajemen Berita & Artikel">
  <div class="space-y-6 sm:space-y-8 max-w-7xl mx-auto">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white p-6 sm:p-8 rounded-3xl shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative overflow-hidden">
      <div class="relative z-10 space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-yellow-300 text-xs font-bold uppercase tracking-wider">
          <span>📰</span>
          <span>Publikasi Sekolah</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          Manajemen Berita & Artikel
        </h1>
        <p class="text-blue-100 text-xs sm:text-sm max-w-xl font-light">
          Kelola berita kegiatan, pengumuman, dan prestasi. Anda dapat menyisipkan foto langsung menggunakan <strong class="text-yellow-300">Link Berbagi Foto Google Drive</strong>.
        </p>
      </div>

      <div class="relative z-10 flex flex-wrap items-center gap-3">
        <button 
          type="button" 
          id="openCreateModalBtn"
          class="bg-yellow-400 hover:bg-yellow-500 text-blue-950 font-black px-5 py-3 rounded-2xl text-xs sm:text-sm transition flex items-center gap-2 shadow-lg hover:scale-105 cursor-pointer"
        >
          <span>➕</span>
          <span>Buat Berita Baru</span>
        </button>
      </div>
      <div class="absolute -right-6 -bottom-6 text-8xl opacity-10 pointer-events-none">
        📰
      </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-white p-4 sm:p-6 rounded-3xl shadow-xs border border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="w-full sm:w-80 relative">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm">🔍</span>
        <input 
          type="text" 
          id="newsSearchInput"
          placeholder="Cari judul berita..." 
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-gray-200 rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-blue-600 transition"
        />
      </div>

      <div class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider hidden sm:inline">Kategori:</span>
        <button 
          type="button" 
          class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-blue-900 text-white" 
          data-category="all"
        >
          Semua
        </button>
        {categories.map(cat => (
          <button 
            type="button" 
            class="filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-slate-100 text-gray-600 hover:bg-blue-50 hover:text-blue-700" 
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- News Table & List -->
    <div class="bg-white rounded-3xl shadow-xs border border-gray-100 overflow-hidden">
      {(!newsList || newsList.length === 0) ? (
        <div class="text-center py-16 p-6 space-y-4">
          <span class="text-5xl block">📰</span>
          <h3 class="font-bold text-gray-800 text-lg">Belum Ada Berita</h3>
          <p class="text-gray-500 text-xs max-w-sm mx-auto">
            Mulai publikasikan kegiatan atau prestasi terbaru SMK Penerbangan Jember sekarang.
          </p>
          <button 
            type="button" 
            id="emptyStateCreateBtn"
            class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-6 py-2.5 rounded-xl text-xs shadow inline-flex items-center gap-1.5 cursor-pointer"
          >
            <span>➕ Tulis Berita Pertama</span>
          </button>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm" id="newsTable">
            <thead>
              <tr class="bg-blue-950 text-white font-bold text-xs uppercase tracking-wider">
                <th class="py-4 px-4 text-center w-12">No</th>
                <th class="py-4 px-4 w-28">Foto</th>
                <th class="py-4 px-4 min-w-[240px]">Judul & Ringkasan</th>
                <th class="py-4 px-4 w-32">Kategori</th>
                <th class="py-4 px-4 w-36">Tanggal Terbit</th>
                <th class="py-4 px-4 text-center w-36">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-xs sm:text-sm" id="newsTbody">
              {newsList.map((item, idx) => {
                const img = formatGoogleDriveImageUrl(item.image_url);
                const formattedDate = new Date(item.published_at || item.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric'
                });

                return (
                  <tr class="hover:bg-blue-50/40 transition news-row" data-title={item.title.toLowerCase()} data-category={item.category}>
                    <td class="py-4 px-4 text-center text-gray-400 font-medium">{idx + 1}</td>
                    <td class="py-4 px-4">
                      {img ? (
                        <div class="w-20 h-14 rounded-xl overflow-hidden bg-slate-100 border border-gray-200 relative group">
                          <img 
                            src={img} 
                            alt={item.title} 
                            class="w-full h-full object-cover group-hover:scale-110 transition duration-300"
                            loading="lazy"
                            onerror="this.onerror=null; this.src='https://placehold.co/120x80/1e3a8a/ffffff?text=Foto';"
                          />
                        </div>
                      ) : (
                        <div class="w-20 h-14 rounded-xl bg-slate-100 text-gray-400 flex items-center justify-center text-xs font-bold border border-gray-200">
                          📷 No Foto
                        </div>
                      )}
                    </td>
                    <td class="py-4 px-4 space-y-1">
                      <a 
                        href={`/news/detail?slug=${item.slug || item.id}`} 
                        target="_blank"
                        class="font-bold text-gray-900 hover:text-blue-700 transition line-clamp-1 block text-sm"
                      >
                        {item.title}
                      </a>
                      <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
                        {item.content?.replace(/<[^>]*>?/gm, '')}
                      </p>
                      <div class="flex items-center gap-2 text-[11px] text-gray-400">
                        <span>Penulis: <strong class="text-gray-600">{item.author || 'Admin'}</strong></span>
                        <span>•</span>
                        <a href={`/news/detail?slug=${item.slug || item.id}`} target="_blank" class="text-blue-600 hover:underline">
                          Buka Halaman ↗️
                        </a>
                      </div>
                    </td>
                    <td class="py-4 px-4">
                      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-800 border border-blue-200">
                        {item.category || 'Berita'}
                      </span>
                    </td>
                    <td class="py-4 px-4 font-medium text-gray-600">
                      {formattedDate}
                    </td>
                    <td class="py-4 px-4 text-center">
                      <div class="flex items-center justify-center gap-1.5">
                        <button 
                          type="button" 
                          class="edit-news-btn p-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-700 transition cursor-pointer"
                          title="Edit Berita"
                          data-id={item.id}
                          data-title={item.title}
                          data-category={item.category}
                          data-image={item.image_url}
                          data-content={item.content}
                          data-author={item.author}
                        >
                          ✏️
                        </button>
                        <button 
                          type="button" 
                          class="delete-news-btn p-2 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 transition cursor-pointer"
                          title="Hapus Berita"
                          data-id={item.id}
                          data-title={item.title}
                        >
                          🗑️
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- MODAL FORM BUAT / EDIT BERITA -->
    <div id="newsModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-2xl w-full shadow-2xl border border-gray-100 space-y-6 max-h-[90vh] overflow-y-auto animate-in zoom-in duration-150">
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-gray-100 pb-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md" id="modalBadge">
              Formulir
            </span>
            <h3 class="text-lg sm:text-xl font-extrabold text-gray-900 mt-1" id="modalTitle">
              Tambah Berita Baru
            </h3>
          </div>
          <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 text-2xl font-bold p-1 cursor-pointer">
            ✕
          </button>
        </div>

        <!-- Modal Form -->
        <form id="newsForm" class="space-y-5">
          <input type="hidden" id="newsId" value="" />

          <!-- Judul Berita -->
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="newsTitleInput">
              Judul Berita <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="newsTitleInput" 
              required
              placeholder="Contoh: Taruna SMK Penerbangan Jember Juara LKS Tingkat Provinsi"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Kategori -->
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="newsCategorySelect">
                Kategori <span class="text-red-500">*</span>
              </label>
              <select 
                id="newsCategorySelect"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition cursor-pointer bg-white"
              >
                {categories.map(cat => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>

            <!-- Penulis -->
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="newsAuthorInput">
                Penulis / Kontributor
              </label>
              <input 
                type="text" 
                id="newsAuthorInput" 
                value="Admin Humas"
                placeholder="Contoh: Humas / Redaksi"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition"
              />
            </div>
          </div>

          <!-- Link Foto Google Drive -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" for="newsImageInput">
                📸 Link Foto Gambar (Google Drive / Direct URL):
              </label>
              <span class="text-[11px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded">
                Mendukung Link GDrive
              </span>
            </div>
            
            <input 
              type="url" 
              id="newsImageInput" 
              placeholder="Contoh: https://drive.google.com/file/d/1aB2c3D4e5F6.../view?usp=sharing"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-xs sm:text-sm outline-none transition font-mono"
            />
            <p class="text-[11px] text-gray-400">
              💡 <strong>Tips Google Drive:</strong> Klik <em>Share (Bagikan)</em> di Google Drive ➔ Ubah akses ke <em>"Anyone with the link (Siapa saja yang memiliki link)"</em> ➔ Salin link lalu tempel di sini.
            </p>

            <!-- Live Image Preview Box -->
            <div id="imagePreviewBox" class="hidden p-3 bg-slate-50 border border-gray-200 rounded-2xl space-y-2">
              <span class="text-xs font-bold text-gray-600 block">Preview Foto:</span>
              <div class="h-44 w-full rounded-xl overflow-hidden bg-slate-200 border border-gray-300 flex items-center justify-center">
                <img 
                  id="previewImg" 
                  src="" 
                  alt="Preview" 
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          </div>

          <!-- Isi Konten Berita -->
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="newsContentInput">
              Isi Lengkap Berita <span class="text-red-500">*</span>
            </label>
            <textarea 
              id="newsContentInput" 
              rows="6" 
              required
              placeholder="Tuliskan isi berita, rincian kegiatan, kutipan, atau informasi pengumuman di sini..."
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition leading-relaxed"
            ></textarea>
          </div>

          <div id="formMsg" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

          <!-- Modal Action Buttons -->
          <div class="flex gap-3 pt-2">
            <button 
              type="button" 
              id="cancelModalBtn"
              class="flex-1 bg-slate-100 hover:bg-slate-200 text-gray-700 font-bold py-3 rounded-xl text-xs sm:text-sm transition cursor-pointer"
            >
              Batal
            </button>
            <button 
              type="submit" 
              id="submitNewsBtn"
              class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-xs sm:text-sm transition shadow flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span id="submitBtnText">💾 Publikasikan Berita</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Floating Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 hidden px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold transition-all"></div>
  </div>
</AdminLayout>

<script>
  // Helper Format Google Drive Link di Client
  function parseGoogleDriveUrl(url: string): string {
    if (!url) return '';
    const trimmed = url.trim();
    
    // drive.google.com/file/d/{ID}
    const fileDMatch = trimmed.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
    if (fileDMatch && fileDMatch[1]) {
      return `https://lh3.googleusercontent.com/d/${fileDMatch[1]}`;
    }

    // drive.google.com/open?id={ID} atau drive.google.com/uc?id={ID}
    const idParamMatch = trimmed.match(/drive\.google\.com\/(?:open|uc)\?(?:[^\s&]*&)?id=([a-zA-Z0-9_-]+)/);
    if (idParamMatch && idParamMatch[1]) {
      return `https://lh3.googleusercontent.com/d/${idParamMatch[1]}`;
    }

    return trimmed;
  }

  // Elements
  const modal = document.getElementById('newsModal')!;
  const openModalBtn = document.getElementById('openCreateModalBtn');
  const emptyStateCreateBtn = document.getElementById('emptyStateCreateBtn');
  const closeModalBtn = document.getElementById('closeModalBtn');
  const cancelModalBtn = document.getElementById('cancelModalBtn');
  const newsForm = document.getElementById('newsForm') as HTMLFormElement;

  const modalTitle = document.getElementById('modalTitle')!;
  const modalBadge = document.getElementById('modalBadge')!;
  const submitBtnText = document.getElementById('submitBtnText')!;
  const newsIdInput = document.getElementById('newsId') as HTMLInputElement;
  const newsTitleInput = document.getElementById('newsTitleInput') as HTMLInputElement;
  const newsCategorySelect = document.getElementById('newsCategorySelect') as HTMLSelectElement;
  const newsAuthorInput = document.getElementById('newsAuthorInput') as HTMLInputElement;
  const newsImageInput = document.getElementById('newsImageInput') as HTMLInputElement;
  const newsContentInput = document.getElementById('newsContentInput') as HTMLTextAreaElement;
  const formMsg = document.getElementById('formMsg')!;

  const imagePreviewBox = document.getElementById('imagePreviewBox')!;
  const previewImg = document.getElementById('previewImg') as HTMLImageElement;
  const toast = document.getElementById('toast')!;
  let toastTimer: any = null;

  function showToast(msg: string, isError = false) {
    clearTimeout(toastTimer);
    toast.className = `fixed bottom-6 right-6 z-50 px-5 py-3 rounded-2xl shadow-2xl text-xs font-bold transition-all ${
      isError ? 'bg-red-600 text-white' : 'bg-slate-900 text-yellow-300 border border-yellow-400/40'
    }`;
    toast.textContent = msg;
    toast.classList.remove('hidden');

    toastTimer = setTimeout(() => {
      toast.classList.add('hidden');
    }, 2500);
  }

  // Live Image Preview saat link GDrive diisi
  function updateImagePreview() {
    const rawUrl = newsImageInput.value;
    if (rawUrl) {
      const parsed = parseGoogleDriveUrl(rawUrl);
      previewImg.src = parsed;
      imagePreviewBox.classList.remove('hidden');
    } else {
      imagePreviewBox.classList.add('hidden');
      previewImg.src = '';
    }
  }

  newsImageInput?.addEventListener('input', updateImagePreview);
  newsImageInput?.addEventListener('change', updateImagePreview);

  // Buka Modal Create
  function openCreateModal() {
    newsForm.reset();
    newsIdInput.value = '';
    modalTitle.textContent = 'Tambah Berita Baru';
    modalBadge.textContent = 'Publikasi Baru';
    modalBadge.className = 'text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md';
    submitBtnText.textContent = '💾 Publikasikan Berita';
    formMsg.classList.add('hidden');
    imagePreviewBox.classList.add('hidden');
    modal.classList.remove('hidden');
  }

  openModalBtn?.addEventListener('click', openCreateModal);
  emptyStateCreateBtn?.addEventListener('click', openCreateModal);

  // Tutup Modal
  function closeModal() {
    modal.classList.add('hidden');
  }
  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);

  // Edit Berita Handler
  document.querySelectorAll('.edit-news-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const title = btn.getAttribute('data-title') || '';
      const category = btn.getAttribute('data-category') || 'Kegiatan';
      const image = btn.getAttribute('data-image') || '';
      const content = btn.getAttribute('data-content') || '';
      const author = btn.getAttribute('data-author') || 'Admin';

      newsIdInput.value = id;
      newsTitleInput.value = title;
      newsCategorySelect.value = category;
      newsAuthorInput.value = author;
      newsImageInput.value = image;
      newsContentInput.value = content;

      modalTitle.textContent = 'Edit Berita & Artikel';
      modalBadge.textContent = 'Mode Edit';
      modalBadge.className = 'text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-1 rounded-md';
      submitBtnText.textContent = '💾 Simpan Perubahan';
      formMsg.classList.add('hidden');

      updateImagePreview();
      modal.classList.remove('hidden');
    });
  });

  // Delete Berita Handler
  document.querySelectorAll('.delete-news-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id')!;
      const title = btn.getAttribute('data-title') || 'berita ini';

      if (confirm(`Apakah Anda yakin ingin menghapus berita:\n"${title}"?`)) {
        try {
          const res = await fetch(`/api/news?id=${id}`, { method: 'DELETE' });
          const data = await res.json();

          if (res.ok && data.success) {
            showToast('✅ Berita berhasil dihapus!');
            setTimeout(() => window.location.reload(), 600);
          } else {
            showToast('❌ Gagal: ' + (data.error || 'Terjadi kesalahan'), true);
          }
        } catch (err) {
          showToast('❌ Gangguan koneksi saat menghapus berita', true);
        }
      }
    });
  });

  // Submit Form (Create / Edit)
  newsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = newsIdInput.value;
    const isEdit = Boolean(id);

    const payload = {
      id: id || undefined,
      title: newsTitleInput.value,
      category: newsCategorySelect.value,
      author: newsAuthorInput.value,
      image_url: newsImageInput.value,
      content: newsContentInput.value
    };

    formMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 block';
    formMsg.textContent = '⏳ Menyimpan data ke database...';

    try {
      const res = await fetch('/api/news', {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.success) {
        formMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-300 block';
        formMsg.textContent = isEdit ? '✅ Berita berhasil diperbarui!' : '✅ Berita berhasil dipublikasikan!';
        setTimeout(() => window.location.reload(), 700);
      } else {
        formMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
        formMsg.textContent = '❌ Gagal: ' + (data.error || 'Terjadi kesalahan');
      }
    } catch (err) {
      formMsg.className = 'p-3.5 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
      formMsg.textContent = '❌ Gangguan koneksi ke server.';
    }
  });

  // Search & Filter Category
  const searchInput = document.getElementById('newsSearchInput') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-cat-btn');
  let activeCat = 'all';

  function filterNewsTable() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    document.querySelectorAll('.news-row').forEach(row => {
      const tr = row as HTMLElement;
      const title = tr.getAttribute('data-title') || '';
      const cat = tr.getAttribute('data-category') || '';

      const matchQ = !q || title.includes(q);
      const matchCat = activeCat === 'all' || cat === activeCat;

      if (matchQ && matchCat) {
        tr.classList.remove('hidden');
      } else {
        tr.classList.add('hidden');
      }
    });
  }

  searchInput?.addEventListener('input', filterNewsTable);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.className = 'filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-slate-100 text-gray-600 hover:bg-blue-50 hover:text-blue-700';
      });
      btn.className = 'filter-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold transition bg-blue-900 text-white';

      activeCat = btn.getAttribute('data-category') || 'all';
      filterNewsTable();
    });
  });
</script>
