---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';

const { data: teachers } = await supabaseAdmin
  .from('teachers')
  .select('*')
  .order('code', { ascending: true, nullsFirst: false });

const now = new Date();
const currentMonth = now.getMonth() + 1;
const currentYear = now.getFullYear();
---

<AdminLayout title="Kelola Data Guru">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-gray-100">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider mb-2">
          <span>👨‍🏫</span>
          <span>Master Data</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Data Guru & Pengajar</h1>
        <p class="text-gray-500 text-xs sm:text-sm mt-1">Kelola nama guru, kode identitas, edit data, atau hapus massal.</p>
      </div>
      <div class="flex gap-3">
        <a 
          href="/admin/attendance"
          class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-3 rounded-xl text-xs sm:text-sm transition flex items-center gap-2 shadow"
        >
          <span>📝</span>
          <span>Buka Presensi Bulan Ini</span>
        </a>
      </div>
    </div>

    <!-- Bulk Action Floating Bar (Muncul saat ada checkbox dicentang) -->
    <div id="bulkActionBar" class="hidden bg-slate-900 text-white p-4 rounded-2xl shadow-xl flex items-center justify-between gap-4 transition-all">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-sm" id="selectedCountBadge">
          0
        </span>
        <span class="text-xs sm:text-sm font-semibold">
          <span id="selectedCountText">0</span> Guru dipilih
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="cancelSelectBtn"
          class="bg-slate-800 hover:bg-slate-700 text-gray-300 px-3.5 py-2 rounded-xl text-xs font-bold transition"
        >
          Batal
        </button>
        <button 
          type="button" 
          id="bulkDeleteBtn"
          class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow"
        >
          <span>Hapus Guru Terpilih 🗑️</span>
        </button>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <!-- Form Tambah Guru (Left Column) -->
      <div class="lg:col-span-4 bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-gray-100 space-y-6 sticky top-24">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md">Input Baru</span>
          <h2 class="text-xl font-bold text-gray-900 mt-2">Tambah Guru Baru</h2>
          <p class="text-xs text-gray-500 mt-0.5">Nama dan kode unik untuk absensi.</p>
        </div>

        <form id="addTeacherForm" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="code">
              Kode Guru <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="code" 
              required 
              placeholder="Contoh: GUR-01, AF-01" 
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition uppercase font-mono font-bold"
            />
            <p class="text-[11px] text-gray-400 mt-1">Kode identitas singkat di tabel absensi.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="name">
              Nama Lengkap Guru <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              id="name" 
              required 
              placeholder="Contoh: Drs. Bambang Sutrisno, S.T." 
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition"
            />
          </div>

          <div id="formMessage" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

          <button 
            type="submit" 
            id="submitBtn"
            class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3.5 px-4 rounded-xl transition shadow hover:shadow-md text-sm flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Simpan Guru Baru</span>
            <span>💾</span>
          </button>
        </form>
      </div>

      <!-- Tabel Daftar Guru (Right Column) -->
      <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-gray-100 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-gray-900">Daftar Guru Terdaftar</h2>
            <p class="text-xs text-gray-500 mt-0.5">Total {teachers?.length || 0} guru tercatat di sistem.</p>
          </div>
          <span class="bg-blue-100 text-blue-800 text-xs font-extrabold px-3 py-1.5 rounded-xl self-start sm:self-auto">
            {teachers?.length || 0} Guru
          </span>
        </div>

        {(!teachers || teachers.length === 0) ? (
          <div class="text-center py-12 border-2 border-dashed border-gray-200 rounded-2xl p-6">
            <span class="text-4xl mb-3 block">👨‍🏫</span>
            <h3 class="font-bold text-gray-800 text-base">Belum Ada Data Guru</h3>
            <p class="text-gray-500 text-xs mt-1">Silakan tambahkan nama dan kode guru melalui formulir di samping.</p>
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-gray-200 text-gray-700 text-xs font-bold uppercase tracking-wider">
                  <th class="py-3.5 px-3 w-10 text-center">
                    <input 
                      type="checkbox" 
                      id="selectAllCheckbox" 
                      class="w-4 h-4 rounded text-blue-600 cursor-pointer" 
                      title="Pilih Semua Guru"
                    />
                  </th>
                  <th class="py-3.5 px-3 w-12 text-center">No</th>
                  <th class="py-3.5 px-4 w-28">Kode</th>
                  <th class="py-3.5 px-4">Nama Lengkap Guru</th>
                  <th class="py-3.5 px-4 text-center w-36">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {teachers.map((teacher: any, idx: number) => (
                  <tr class="hover:bg-blue-50/40 transition group" data-teacher-id={teacher.id}>
                    <td class="py-3.5 px-3 text-center">
                      <input 
                        type="checkbox" 
                        class="teacher-checkbox w-4 h-4 rounded text-blue-600 cursor-pointer" 
                        data-id={teacher.id}
                        data-name={teacher.name}
                      />
                    </td>
                    <td class="py-3.5 px-3 text-center text-gray-500 font-medium">{idx + 1}</td>
                    <td class="py-3.5 px-4 font-mono font-bold text-blue-700">
                      <span class="bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-lg">
                        {teacher.code || '-'}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 font-bold text-gray-900">{teacher.name}</td>
                    <td class="py-3.5 px-4 text-center">
                      <div class="flex items-center justify-center gap-2">
                        <!-- Edit Button -->
                        <button 
                          type="button" 
                          class="edit-btn text-xs font-bold text-blue-700 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 border border-blue-200 px-2.5 py-1.5 rounded-lg transition flex items-center gap-1"
                          data-id={teacher.id}
                          data-name={teacher.name}
                          data-code={teacher.code}
                        >
                          <span>✏️ Edit</span>
                        </button>
                        <!-- Single Delete Button -->
                        <button 
                          type="button" 
                          class="single-delete-btn text-xs font-bold text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 border border-red-200 px-2.5 py-1.5 rounded-lg transition"
                          data-id={teacher.id}
                          data-name={teacher.name}
                          title="Hapus Guru"
                        >
                          🗑️
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Modal Edit Guru -->
  <div id="editModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-gray-100 space-y-6 animate-in fade-in zoom-in duration-150">
      <div class="flex items-center justify-between border-b border-gray-100 pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md">Edit Data</span>
          <h3 class="text-lg font-bold text-gray-900 mt-1">Perbarui Informasi Guru</h3>
        </div>
        <button type="button" id="closeEditModalBtn" class="text-gray-400 hover:text-gray-600 text-2xl font-bold p-1">
          ✕
        </button>
      </div>

      <form id="editTeacherForm" class="space-y-4">
        <input type="hidden" id="editTeacherId" />

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="editCode">Kode Guru</label>
          <input 
            type="text" 
            id="editCode" 
            required 
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition font-mono uppercase font-bold" 
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" for="editName">Nama Lengkap Guru</label>
          <input 
            type="text" 
            id="editName" 
            required 
            class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-sm outline-none transition" 
          />
        </div>

        <div id="editMsg" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

        <div class="flex gap-3 pt-2">
          <button 
            type="button" 
            id="cancelEditBtn"
            class="flex-1 bg-slate-100 hover:bg-slate-200 text-gray-700 font-bold py-2.5 rounded-xl transition text-sm"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="saveEditBtn"
            class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl transition shadow text-sm"
          >
            Simpan Perubahan 💾
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  // Add Teacher Form
  const addForm = document.getElementById('addTeacherForm') as HTMLFormElement;
  const msg = document.getElementById('formMessage')!;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('code') as HTMLInputElement).value;
    const name = (document.getElementById('name') as HTMLInputElement).value;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    msg.className = 'p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 block';
    msg.textContent = '⏳ Sedang menyimpan data guru...';

    try {
      const res = await fetch('/api/teachers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, name })
      });

      const data = await res.json();

      if (res.ok && data.success) {
        msg.className = 'p-3 rounded-xl text-xs font-semibold bg-green-50 text-green-700 border border-green-200 block';
        msg.textContent = '✅ Guru berhasil ditambahkan!';
        addForm.reset();
        setTimeout(() => window.location.reload(), 700);
      } else {
        msg.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
        msg.textContent = '❌ Gagal: ' + (data.error || 'Terjadi kesalahan');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Simpan Guru Baru</span> <span>💾</span>';
      }
    } catch (err: any) {
      msg.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
      msg.textContent = '❌ Gangguan koneksi.';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Simpan Guru Baru</span> <span>💾</span>';
    }
  });

  // Edit Teacher Modal
  const editModal = document.getElementById('editModal')!;
  const editForm = document.getElementById('editTeacherForm') as HTMLFormElement;
  const editIdInput = document.getElementById('editTeacherId') as HTMLInputElement;
  const editCodeInput = document.getElementById('editCode') as HTMLInputElement;
  const editNameInput = document.getElementById('editName') as HTMLInputElement;
  const editMsg = document.getElementById('editMsg')!;
  const saveEditBtn = document.getElementById('saveEditBtn') as HTMLButtonElement;

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const code = btn.getAttribute('data-code') || '';

      editIdInput.value = id;
      editNameInput.value = name;
      editCodeInput.value = code;
      editMsg.classList.add('hidden');

      editModal.classList.remove('hidden');
    });
  });

  function closeEditModal() {
    editModal.classList.add('hidden');
  }

  document.getElementById('closeEditModalBtn')?.addEventListener('click', closeEditModal);
  document.getElementById('cancelEditBtn')?.addEventListener('click', closeEditModal);

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveEditBtn.disabled = true;
    saveEditBtn.textContent = 'Menyimpan...';

    editMsg.className = 'p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 block';
    editMsg.textContent = '⏳ Menyimpan perubahan...';

    try {
      const res = await fetch('/api/teachers', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: editIdInput.value,
          code: editCodeInput.value,
          name: editNameInput.value
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        editMsg.className = 'p-3 rounded-xl text-xs font-semibold bg-green-50 text-green-700 border border-green-200 block';
        editMsg.textContent = '✅ Perubahan berhasil disimpan!';
        setTimeout(() => window.location.reload(), 700);
      } else {
        editMsg.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
        editMsg.textContent = '❌ Gagal: ' + (data.error || 'Terjadi kesalahan');
        saveEditBtn.disabled = false;
        saveEditBtn.textContent = 'Simpan Perubahan 💾';
      }
    } catch (err) {
      editMsg.className = 'p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-700 border border-red-200 block';
      editMsg.textContent = '❌ Kesalahan jaringan.';
      saveEditBtn.disabled = false;
      saveEditBtn.textContent = 'Simpan Perubahan 💾';
    }
  });

  // Single Delete
  document.querySelectorAll('.single-delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');

      if (confirm(`Yakin ingin menghapus guru "${name}"? Data absensi guru ini juga akan terhapus.`)) {
        try {
          const res = await fetch('/api/teachers', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert('Gagal menghapus: ' + (data.error || 'Terjadi kesalahan'));
          }
        } catch (err) {
          alert('Gangguan koneksi.');
        }
      }
    });
  });

  // Checkbox Select & Bulk Delete
  const selectAll = document.getElementById('selectAllCheckbox') as HTMLInputElement;
  const checkboxes = document.querySelectorAll('.teacher-checkbox') as NodeListOf<HTMLInputElement>;
  const bulkBar = document.getElementById('bulkActionBar')!;
  const countBadge = document.getElementById('selectedCountBadge')!;
  const countText = document.getElementById('selectedCountText')!;
  const cancelBtn = document.getElementById('cancelSelectBtn')!;
  const bulkDeleteBtn = document.getElementById('bulkDeleteBtn')!;

  function updateBulkBar() {
    const selected = Array.from(checkboxes).filter(cb => cb.checked);
    const count = selected.length;

    if (count > 0) {
      bulkBar.classList.remove('hidden');
      countBadge.textContent = String(count);
      countText.textContent = String(count);
    } else {
      bulkBar.classList.add('hidden');
    }

    if (selectAll) {
      selectAll.checked = count === checkboxes.length && count > 0;
    }
  }

  selectAll?.addEventListener('change', () => {
    checkboxes.forEach(cb => {
      cb.checked = selectAll.checked;
    });
    updateBulkBar();
  });

  checkboxes.forEach(cb => {
    cb.addEventListener('change', updateBulkBar);
  });

  cancelBtn?.addEventListener('click', () => {
    checkboxes.forEach(cb => cb.checked = false);
    if (selectAll) selectAll.checked = false;
    updateBulkBar();
  });

  bulkDeleteBtn?.addEventListener('click', async () => {
    const selectedIds = Array.from(checkboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.getAttribute('data-id')!)
      .filter(Boolean);

    if (selectedIds.length === 0) return;

    if (confirm(`Yakin ingin menghapus ${selectedIds.length} guru terpilih secara permanen beserta data absensinya?`)) {
      try {
        const res = await fetch('/api/teachers', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: selectedIds })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert(`${selectedIds.length} guru berhasil dihapus.`);
          window.location.reload();
        } else {
          alert('Gagal: ' + (data.error || 'Terjadi kesalahan'));
        }
      } catch (err) {
        alert('Gangguan koneksi.');
      }
    }
  });
</script>
